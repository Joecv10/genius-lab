    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="System.out.println(&quot;Carga raw OK en &quot; + (System.currentTimeMillis() - (Long)globalMap.get(&quot;t_start&quot;)) / 1000.0 + &quot; s&quot;);&#xA;java.sql.Connection conn = (java.sql.Connection) globalMap.get(&quot;conn_tDBConnection_1&quot;);&#xA;String[] files = {&quot;01_stg.sql&quot;, &quot;02_mart.sql&quot;};&#xA;&#xA;for (String f : files) {&#xA;    long t0 = System.currentTimeMillis();&#xA;    String sql = new String(java.nio.file.Files.readAllBytes(&#xA;        java.nio.file.Paths.get(context.sql_dir + f)), &quot;UTF-8&quot;);&#xA;    sql = sql.replaceAll(&quot;(?m)^\\s*--.*$&quot;, &quot;&quot;);   // quita comentarios&#xA;    java.sql.Statement st = conn.createStatement();&#xA;    for (String s : sql.split(&quot;;&quot;)) {&#xA;        if (s.trim().length() > 0) st.execute(s.trim());&#xA;    }&#xA;    st.close();&#xA;    System.out.println(f + &quot; OK en &quot; + (System.currentTimeMillis() - t0) / 1000.0 + &quot; s&quot;);&#xA;}"/>
